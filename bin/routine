#!/bin/bash
# routine — executable markdown on rails. Design: docs/index.html.
# ※ bash-3-2
set -u

# ─── environment ──────────────────────────────────────────────────────────────

LC_ALL=C; export LC_ALL   # glob ranges are collation-free — [!a-z0-9-] must reject uppercase

SELF_DIR=$(cd "$(dirname "$0")" && pwd)
SELF="$SELF_DIR/$(basename "$0")"

abspath() { # $1=path
  case "$1" in /*) printf '%s\n' "$1" ;; *) printf '%s\n' "$PWD/$1" ;; esac
}

ROUTINE_HOME=$(abspath "${ROUTINE_HOME:-${HOME:-/tmp}/.routines}")
ROUTINE_DIR=$(abspath "${ROUTINE_DIR:-$ROUTINE_HOME}")
ROUTINE_STATE=$(abspath "${ROUTINE_STATE:-$ROUTINE_HOME/.state}")
ROUTINE_AGENTS_DIR=$(abspath "${ROUTINE_AGENTS_DIR:-${HOME:-/tmp}/Library/LaunchAgents}")
ROUTINE_LAUNCHCTL="${ROUTINE_LAUNCHCTL:-launchctl}"
ROUTINE_CLAUDE="${ROUTINE_CLAUDE:-claude}"
ROUTINE_PMSET="${ROUTINE_PMSET:-pmset}"
export ROUTINE_HOME ROUTINE_DIR ROUTINE_STATE ROUTINE_AGENTS_DIR
export ROUTINE_LAUNCHCTL ROUTINE_CLAUDE ROUTINE_PMSET

if date -u -r 0 +%Y >/dev/null 2>&1; then DATE_FLAVOR=bsd; else DATE_FLAVOR=gnu; fi

now() { printf '%s\n' "${ROUTINE_NOW:-$(date +%s)}"; }

epoch_fmt() { # $1=epoch $2=strftime format — always UTC
  if [ "$DATE_FLAVOR" = bsd ]; then date -u -r "$1" +"$2"; else date -u -d "@$1" +"$2"; fi
}

die() { # $1=exit code, rest=message
  local code="$1"; shift
  printf 'routine: %s\n' "$*" >&2
  exit "$code"
}

usage() {
  cat <<'EOF'
routine — executable markdown on rails

  routine run <name>     run one routine document
  routine run --due      run every due routine (silent when none are)
  routine status         schedule × due? × last run, one row per routine
  routine install        install the launchd tick agent (com.routines.due)
  routine uninstall      remove it
  routine sync-ci        (re)write ./.github/workflows/routines.yaml here
  routine help           this text

exit: 64 usage/unknown routine · 75 lock held · 78 requires missing ·
      124 timeout · else the failing block's code

env: ROUTINE_HOME ROUTINE_DIR ROUTINE_STATE ROUTINE_AGENTS_DIR
     ROUTINE_LAUNCHCTL ROUTINE_CLAUDE ROUTINE_NOW ROUTINE_PMSET
EOF
}

# ─── document parsing ─────────────────────────────────────────────────────────

fm_get() { # $1=doc $2=key — flat key: value from the leading --- fence pair
  awk -v want="$2" '
    { sub(/\r$/, "") }
    NR == 1 { if ($0 != "---") exit; inside = 1; next }
    inside && $0 == "---" { exit }
    inside {
      i = index($0, ":"); if (i == 0) next
      k = substr($0, 1, i - 1); v = substr($0, i + 1)
      sub(/[ \t]+#.*$/, "", v)
      gsub(/^[ \t]+|[ \t]+$/, "", k); gsub(/^[ \t]+|[ \t]+$/, "", v)
      # `*/15 * * * *` is a YAML alias unquoted, so a quoted value is the natural spelling
      if (v ~ /^".*"$/ || v ~ /^\047.*\047$/) v = substr(v, 2, length(v) - 2)
      if (k == want) { print v; exit }
    }
  ' "$1"
}

# CommonMark fences: ``` or ~~~ runs of 3+, indented 0-3; only a run of the same
# character at least as long closes, so a ~~~ or ```` fence can show a ```sh
# example without running it. A backtick info string holding a backtick is prose
# (home-inventory.md writes ````` ````sh ````` inline), never an opener.
extract_blocks() { # $1=doc $2=outdir — writes NNN.sh per block, prints the count
  awk -v dir="$2" '
    { sub(/\r$/, "") }
    inb {
      f = $0; sub(/^ ? ? ?/, "", f); sub(/[ \t]+$/, "", f)
      if (f ~ /^(```+|~~~+)$/ && substr(f, 1, 1) == fch && length(f) >= flen) {
        if (cur != "") close(cur); cur = ""; inb = 0; next
      }
      l = $0; for (i = 0; i < ind && substr(l, 1, 1) == " "; i++) l = substr(l, 2)
      if (cur != "") print l >> cur
      next
    }
    # an HTML comment is an HTML block, never a code block: a fence inside one is disabled
    inc { if (index($0, "-->")) inc = 0; next }
    /^ ? ? ?<!--/ { inc = !index(substr($0, index($0, "<!--") + 4), "-->"); next }
    /^ ? ? ?(```|~~~)/ {
      ind = match($0, /[`~]/) - 1; f = substr($0, ind + 1); fch = substr(f, 1, 1)
      flen = 0; while (substr(f, flen + 1, 1) == fch) flen++
      tag = substr(f, flen + 1)
      if (fch == "`" && index(tag, "`")) next
      sub(/^[ \t]+/, "", tag); sub(/[ \t].*$/, "", tag)
      inb = 1; cur = ""
      if (tag == "sh" || tag == "bash") {
        n++; cur = sprintf("%s/%03d.sh", dir, n); printf "" > cur
      }
    }
    END { print n + 0 }
  ' "$1"
}

json_get() { # $1=file $2=key — reads the single-line last-run.json
  [ -f "$1" ] || return 1
  sed -n 's/.*"'"$2"'":"\{0,1\}\([^",}]*\)"\{0,1\}.*/\1/p' "$1"
}

# ─── observability ────────────────────────────────────────────────────────────

iso() { # $1=epoch — the one timestamp shape every log line and JSON field carries
  epoch_fmt "$1" '%Y-%m-%dT%H:%M:%SZ'
}

keep_tail() { # $1=file $2=lines to keep — rewrite in place, never in the reader's fd
  local tmp="$1.trim.$$"
  tail -n "$2" "$1" > "$tmp" 2>/dev/null && mv -f "$tmp" "$1"
  rm -f "$tmp"
}

file_bytes() { # $1=file — prints a decimal size, or nothing when unmeasurable
  local sz
  sz=$(wc -c < "$1" 2>/dev/null | tr -d ' ')
  case "$sz" in ""|*[!0-9]*) return 1 ;; esac
  printf '%s\n' "$sz"
}

bound_bytes() { # $1=file $2=max bytes $3=lines to keep
  local sz
  [ -f "$1" ] || return 0
  sz=$(file_bytes "$1") || return 0
  [ "$sz" -gt "$2" ] || return 0
  keep_tail "$1" "$3"
}

bound_lines() { # $1=file $2=max lines $3=lines to keep
  local n
  [ -f "$1" ] || return 0
  n=$(awk 'END { print NR + 0 }' "$1" 2>/dev/null)
  case "$n" in ""|*[!0-9]*) return 0 ;; esac
  [ "$n" -gt "$2" ] || return 0
  keep_tail "$1" "$3"
}

show() { # $1=capture file — its last MiB into the run log; a runaway block must not fill the disk twice
  local sz
  sz=$(file_bytes "$1") || sz=0
  [ "$sz" -le 1048576 ] || printf '… %s bytes cut — the last 1048576 follow\n' "$((sz - 1048576))"
  tail -c 1048576 "$1"
}

tick_log() { # rest=message — the sweep's own journal, bounded at ~1 MB
  local f="$ROUTINE_STATE/tick.log"
  mkdir -p "$ROUTINE_STATE" 2>/dev/null
  printf '%s %s\n' "$(iso "$(now)")" "$*" >> "$f" 2>/dev/null
  bound_bytes "$f" 1048576 2000
  return 0
}

# launchd holds due.log's fd open (StandardOutPath), so a rename orphans every
# later write into an unlinked inode — the rotation must copy and truncate.
rotate_due_log() {
  local f="$ROUTINE_STATE/due.log" sz
  [ -f "$f" ] || return 0
  sz=$(file_bytes "$f") || return 0
  [ "$sz" -gt 5242880 ] || return 0
  cp "$f" "$f.1" 2>/dev/null && : > "$f"
  return 0
}

# ─── cron ─────────────────────────────────────────────────────────────────────

inset() { # $1=set $2=value
  case " $1 " in *" $2 "*) return 0 ;; esac
  return 1
}

expand() { # $1=field $2=lo $3=hi — prints the expanded value set
  local fld="$1" lo="$2" hi="$3" out="" part step s e i old="$IFS"
  set -f; IFS=','; set -- $fld; IFS="$old"; set +f
  for part in "$@"; do
    step=1
    case "$part" in */*) step="${part##*/}"; part="${part%%/*}" ;; esac
    case "$step" in ""|*[!0-9]*) return 1 ;; esac
    [ "$((10#$step))" -ge 1 ] || return 1
    case "$part" in
      '*') s="$lo"; e="$hi" ;;
      *-*) s="${part%%-*}"; e="${part#*-}" ;;
      *) s="$part"; e="$part"; if [ "$((10#$step))" -gt 1 ]; then e="$hi"; fi ;;
    esac
    case "$s" in ""|*[!0-9]*) return 1 ;; esac
    case "$e" in ""|*[!0-9]*) return 1 ;; esac
    s=$((10#$s)); e=$((10#$e)); step=$((10#$step))
    [ "$s" -ge "$lo" ] && [ "$e" -le "$hi" ] && [ "$s" -le "$e" ] || return 1
    i="$s"
    while [ "$i" -le "$e" ]; do out="$out $i"; i=$((i + step)); done
  done
  [ -n "$out" ] || return 1
  printf '%s\n' "$out"
}

# ※ due-derivation
next_fire_after() { # $1=epoch $2=5-field cron — prints the next fire strictly after
  local start="$1" f_min f_hour f_dom f_mon f_dow mins hours doms mons dows
  local day0 d=0 both de mm dd ww ok h m t
  set -f; set -- $2; set +f
  [ $# -eq 5 ] || return 1
  f_min="$1" f_hour="$2" f_dom="$3" f_mon="$4" f_dow="$5"
  mins=$(expand "$f_min" 0 59) || return 1
  hours=$(expand "$f_hour" 0 23) || return 1
  doms=$(expand "$f_dom" 1 31) || return 1
  mons=$(expand "$f_mon" 1 12) || return 1
  dows=$(expand "$f_dow" 0 7) || return 1
  case " $dows " in *" 7 "*) dows="$dows 0" ;; esac
  # cronie's DOM_STAR/DOW_STAR: a day field opening with * (*/2 too) ANDs with
  # the other; only two restricted fields OR together
  both=0
  case "$f_dom" in '*'*) both=1 ;; esac
  case "$f_dow" in '*'*) both=1 ;; esac
  day0=$((start - start % 86400))
  # eight years: Feb 29 recurs every four, and 2100 skips one
  while [ "$d" -le 2922 ]; do
    de=$((day0 + d * 86400)); d=$((d + 1))
    set -- $(epoch_fmt "$de" '%m %d %w')
    mm=$((10#$1)); dd=$((10#$2)); ww=$((10#$3))
    # a dead month jumps to its 28th, then walks — never past a next month's 1st
    if ! inset "$mons" "$mm"; then [ "$dd" -lt 28 ] && d=$((d + 27 - dd)); continue; fi
    ok=0
    inset "$doms" "$dd" && ok=1
    inset "$dows" "$ww" && ok=$((ok + 1))
    [ "$ok" -gt "$both" ] || continue
    h=0
    while [ "$h" -le 23 ]; do
      if inset "$hours" "$h"; then
        m=0
        while [ "$m" -le 59 ]; do
          if inset "$mins" "$m"; then
            t=$((de + h * 3600 + m * 60))
            if [ "$t" -gt "$start" ]; then printf '%s\n' "$t"; return 0; fi
          fi
          m=$((m + 1))
        done
      fi
      h=$((h + 1))
    done
  done
  return 1
}

next_fire_of() { # $1=name — the next fire epoch; 0 when never run, non-zero when unschedulable
  local doc="$ROUTINE_DIR/$1.md" sched se
  sched=$(fm_get "$doc" schedule)
  [ -n "$sched" ] || return 1
  se=$(json_get "$ROUTINE_STATE/$1/last-run.json" started_epoch) || se=""
  # a schedule this parser rejects (@daily, MON-FRI) must never fire, not fire once
  case "$se" in ""|*[!0-9]*) next_fire_after 0 "$sched" >/dev/null || return 1; printf '0\n'; return 0 ;; esac
  next_fire_after "$se" "$sched"
}

is_due() { # $1=name — true when the schedule's next fire has passed
  local nxt
  nxt=$(next_fire_of "$1") || return 1
  [ "$nxt" -le "$(now)" ]
}

# ─── run ──────────────────────────────────────────────────────────────────────

dash() { # $1=count
  local n="$1" s=""
  while [ "$n" -gt 0 ]; do s="${s}─"; n=$((n - 1)); done
  printf '%s' "$s"
}

divider() { # $1=ascii label — 80 columns
  printf '%s %s %s\n' "$(dash 8)" "$1" "$(dash $((70 - ${#1})))"
}

# ※ last-run-contract
on_exit() {
  local rc=$? fin deg line cp n
  trap '' HUP INT TERM   # a second signal must not cut the escalation or the record short
  if [ -n "${WD_PID:-}" ]; then kill "$WD_PID" 2>/dev/null; fi
  # a signal lands mid-sequence or mid-escalation — stop the sequence, then the
  # block's group (TERM, two seconds, KILL), before the lock and the record
  # below tell the next run the routine is idle
  if [ -n "${SEQ_PID:-}${WD_PID:-}" ]; then
    if [ -n "${SEQ_PID:-}" ]; then kill "$SEQ_PID" 2>/dev/null; fi
    cp=$(cat "$RUN_TMP/child.pid" 2>/dev/null); n=0
    kill_tree TERM "$cp"
    while [ -n "$cp" ] && [ "$n" -lt 20 ] && { kill -0 -"$cp" || kill -0 "$cp"; } 2>/dev/null; do
      sleep 0.1; n=$((n + 1))
    done
    [ "$n" -lt 20 ] || kill_tree KILL "$cp"
  fi
  if [ "${WRITE_LAST:-0}" = 1 ]; then
    mkdir -p "$STATE_DIR"
    fin=$(now)
    # a clean run is the proof the degradation lifted — clear before stamping,
    # so the record and the marker can never disagree (the catch clears it too)
    if [ "$rc" -eq 0 ]; then rm -f "$STATE_DIR/degraded"; fi
    if [ -f "$STATE_DIR/degraded" ]; then deg=true; else deg=false; fi
    line=$(printf \
      '{"started":"%s","started_epoch":%s,"finished":"%s","exit":%s,"duration":%s,"degraded":%s}' \
      "$STARTED_ISO" "$STARTED_EPOCH" "$(iso "$fin")" \
      "$rc" "$((fin - STARTED_EPOCH))" "$deg")
    # renamed into place: a crash mid-write never leaves an empty record (read as never run)
    printf '%s\n' "$line" > "$STATE_DIR/last-run.json.$$" && mv -f "$STATE_DIR/last-run.json.$$" "$STATE_DIR/last-run.json"
    printf '%s\n' "$line" >> "$STATE_DIR/runs.jsonl"
    bound_lines "$STATE_DIR/runs.jsonl" 5000 2000
  fi
  if [ "${OWN_LOCK:-0}" = 1 ]; then rm -rf "$LOCK_DIR"; fi
  if [ -n "${RUN_TMP:-}" ]; then rm -rf "$RUN_TMP"; fi
  exit "$rc"
}

started_at() { ps -o lstart= -p "$1" 2>/dev/null || :; } # $1=pid — its start time, the pid's identity

take_lock() {
  mkdir "$LOCK_DIR" 2>/dev/null && started_at $$ > "$LOCK_DIR/started" && printf '%s\n' $$ > "$LOCK_DIR/pid"
}

acquire_lock() {
  local p s c
  mkdir -p "$STATE_DIR"
  if take_lock; then return 0; fi
  p=$(cat "$LOCK_DIR/pid" 2>/dev/null); LOCK_PID="${p:-unknown}"
  # a lock outlives a SIGKILL or a power cut, and after a reboot its pid may belong to
  # any process: alive is the pid AND its start time, wherever both can be read
  if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then
    s=$(cat "$LOCK_DIR/started" 2>/dev/null); c=$(started_at "$p")
    [ -n "$s" ] && [ -n "$c" ] && [ "$c" != "$s" ] || return 1
  fi
  # no pid yet is a holder between its mkdir and its pid write — a crash in that
  # gap is all that leaves one empty, so a minute's grace reaps it soon enough
  if [ -z "$p" ] && [ -n "$(find "$LOCK_DIR" -maxdepth 0 -mmin -1 2>/dev/null)" ]; then return 1; fi
  rm -rf "$LOCK_DIR"
  take_lock
}

kill_tree() { # $1=signal $2=pid — the pid leads its own process group (set -m)
  kill -"$1" -"$2" 2>/dev/null || kill -"$1" "$2" 2>/dev/null
}

exec_block() { # $1=index $2=capture file
  ROUTINE_NAME="$RNAME" ROUTINE_STATE_DIR="$STATE_DIR" \
    /bin/bash -e "$BLK_DIR/$(printf '%03d' "$1").sh" > "$2" 2>&1 &
  local p=$!
  printf '%s\n' "$p" > "$RUN_TMP/child.pid"
  # the watchdog marks timedout before it reads child.pid — one of the two sees the other
  [ ! -f "$RUN_TMP/timedout" ] || kill_tree TERM "$p"
  wait "$p" 2>/dev/null
}

# The Stop hook opens a thread from a `needs input:`/`failed:` line, keyed to the
# catch's throwaway session — one unkeyed duplicate per run, nagging forever.
CATCH_THREAD_RULE='Never start a line of your final message with `needs input:` or `failed:` —
not even when quoting block output (indent or backtick such lines). A Stop hook
opens a thread from such a line, keyed to this throwaway session, so every run
would add an unkeyed duplicate that never closes. When the owner must act, open
or reply to the thread under the stable key the document names (e.g.
`ci:<repo>:<sha7>`, `home-inventory:<entry>`, `claude-breaker`), and state
failures in plain prose.'

# ※ catch-retry
catch_block() { # $1=index $2=capture file $3=block exit code
  local prompt cout p rc crc t0
  if [ "$ON_ERROR" = fail ]; then return "$3"; fi
  if ! command -v "$ROUTINE_CLAUDE" >/dev/null 2>&1; then
    printf 'catch degraded: claude unavailable\n'
    # the log is per-run and the exit code is the block's — without this marker
    # a degraded catch is invisible to status and to the routines-health sweep
    mkdir -p "$STATE_DIR"
    iso "$(now)" > "$STATE_DIR/degraded"
    return "$3"
  fi
  rm -f "$STATE_DIR/degraded"
  divider "block $1 · catch"
  prompt="You are running unattended inside routine '$RNAME', invoked by bin/routine.
Block $1 of the document below exited $3.

=== routine document: $DOC ===
$(cat "$DOC")
=== end document ===

=== last 200 lines of block $1 output ===
$(tail -n 200 "$2" | tail -c 65536)
=== end output ===

Diagnose the failure and repair state only. Do NOT continue the routine and do
not run the remaining blocks — the runner retries block $1 once after you exit.

$CATCH_THREAD_RULE"
  cout="$RUN_TMP/catch-$1.out"
  t0=$(date +%s)
  # ROUTINE_HOME is already exported; the other two let the doc's
  # $ROUTINE_STATE_DIR references resolve in the agent's commands
  ROUTINE_NAME="$RNAME" ROUTINE_STATE_DIR="$STATE_DIR" \
    "$ROUTINE_CLAUDE" --model opus --permission-mode=auto --no-session-persistence \
    -p "$prompt" > "$cout" 2>&1 &
  p=$!
  printf '%s\n' "$p" > "$RUN_TMP/child.pid"
  # the exec_block handshake — the agent past the deadline stops too
  [ ! -f "$RUN_TMP/timedout" ] || kill_tree TERM "$p"
  wait "$p" 2>/dev/null; crc=$?
  show "$cout"
  # the agent's code is diagnostic only — the retry below is still the verdict
  printf 'catch: claude exit=%s elapsed=%ss\n' "$crc" "$(($(date +%s) - t0))"
  # the watchdog fired once, on the agent, and is gone — a retry would be unbounded
  if [ -f "$RUN_TMP/timedout" ]; then exit 124; fi
  divider "block $1 · retry"
  exec_block "$1" "$2"; rc=$?
  show "$2"
  return "$rc"
}

run_sequence() {
  trap - EXIT HUP INT TERM
  set -m                        # each block leads its own group — killable whole
  local i=1 code out t0
  while [ "$i" -le "$NBLOCKS" ]; do
    out="$RUN_TMP/blk-$i.out"
    divider "block $i"
    t0=$(date +%s)
    exec_block "$i" "$out"; code=$?
    show "$out"
    divider "block $i · exit $code · $(($(date +%s) - t0))s"
    if [ -f "$RUN_TMP/timedout" ]; then exit 124; fi
    if [ "$code" -ne 0 ]; then
      t0=$(date +%s)
      catch_block "$i" "$out" "$code"; code=$?
      divider "block $i · caught exit $code · $(($(date +%s) - t0))s"
      if [ -f "$RUN_TMP/timedout" ]; then exit 124; fi
      if [ "$code" -ne 0 ]; then exit "$code"; fi
    fi
    i=$((i + 1))
  done
  exit 0
}

watchdog() { # $1=deadline epoch $2=sequence pid
  trap - EXIT HUP INT TERM
  local n=0 p
  while :; do
    if [ -f "$RUN_TMP/done" ]; then exit 0; fi
    if [ "$(date +%s)" -ge "$1" ]; then break; fi
    sleep 1
  done
  : > "$RUN_TMP/timedout"
  p=$(cat "$RUN_TMP/child.pid" 2>/dev/null)
  if [ -z "$p" ]; then
    printf 'watchdog: deadline reached, no child pid to kill\n'
    exit 0
  fi
  printf 'watchdog: deadline reached, killing pid %s\n' "$p"
  kill_tree TERM "$p"
  while [ "$n" -lt 10 ]; do
    if ! { kill -0 -"$p" || kill -0 "$p"; } 2>/dev/null; then
      printf 'watchdog: pid %s exited on TERM after %ss\n' "$p" "$n"
      exit 0
    fi
    sleep 1; n=$((n + 1))
  done
  printf 'watchdog: pid %s survived TERM for %ss, escalating to KILL\n' "$p" "$n"
  kill_tree KILL "$p"
  sleep 1
  printf 'watchdog: killing sequence pid %s\n' "$2"
  kill -KILL "$2" 2>/dev/null
}

cmd_run() { # $1=name
  local missing="" v val deadline rc
  RNAME="$1"
  # both gates fire before the run log exists — tick.log is the only durable ear
  case "$RNAME" in
    ""|-*|*[!a-z0-9-]*)
      tick_log "run refused: invalid routine name: ${RNAME:-<empty>}"
      die 64 "invalid routine name: $RNAME" ;;
  esac
  DOC="$ROUTINE_DIR/$RNAME.md"
  if [ ! -f "$DOC" ]; then
    tick_log "run refused: no routine $RNAME ($DOC)"
    die 64 "no routine $RNAME"
  fi

  TIMEOUT=$(fm_get "$DOC" timeout)
  case "$TIMEOUT" in ""|*[!0-9]*) TIMEOUT=600 ;; esac
  TIMEOUT=$((10#$TIMEOUT))
  [ "$TIMEOUT" -gt 0 ] || TIMEOUT=600   # a zero deadline would record every run as 124
  ON_ERROR=$(fm_get "$DOC" on_error)
  [ "$ON_ERROR" = fail ] || ON_ERROR=claude
  STATE_DIR="$ROUTINE_STATE/$RNAME"
  LOCK_DIR="$STATE_DIR/lock"
  STARTED_EPOCH=$(now)
  STARTED_ISO=$(iso "$STARTED_EPOCH")
  WRITE_LAST=1; OWN_LOCK=0; WD_PID=""; SEQ_PID=""; RUN_TMP=""
  trap on_exit EXIT; trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM

  if ! acquire_lock; then
    WRITE_LAST=0
    # last-run.json belongs to the holder — contention gets its own ledger
    printf '%s lock-blocked holder-pid=%s\n' "$STARTED_ISO" "$LOCK_PID" \
      >> "$STATE_DIR/lock-blocked.log" 2>/dev/null
    bound_lines "$STATE_DIR/lock-blocked.log" 200 200
    printf 'routine: %s already running (pid %s)\n' "$RNAME" "$LOCK_PID" >&2
    exit 75
  fi
  OWN_LOCK=1

  set -f
  for v in $(fm_get "$DOC" requires); do
    case "$v" in [0-9]*|*[!A-Za-z0-9_]*) missing="$missing $v"; continue ;; esac
    eval "val=\${$v:-}"
    [ -n "$val" ] || missing="$missing $v"
  done
  set +f
  if [ -n "$missing" ]; then
    tick_log "run $RNAME refused: missing required env:$missing"
    printf 'routine: %s missing required env:%s\n' "$RNAME" "$missing" >&2
    exit 78
  fi

  mkdir -p "$STATE_DIR/logs"
  find "$STATE_DIR/logs" -maxdepth 1 -type f -name '*.log' -mtime +14 -delete 2>/dev/null
  # the stamp is second-resolution and a routine can be run twice inside one —
  # the pid is what keeps two runs from sharing a log file
  LOG="$STATE_DIR/logs/$(epoch_fmt "$STARTED_EPOCH" '%Y%m%dT%H%M%SZ')-$$.log"
  RUN_TMP=$(mktemp -d "${TMPDIR:-/tmp}/routine.XXXXXX")
  # ※ no-process-substitution
  # fifos, not >(tee): Seatbelt denies the /dev/fd paths process substitution opens
  mkfifo "$RUN_TMP/out" "$RUN_TMP/err"
  # a reader that goes away (`routine run x | head`) must not SIGPIPE the tee: the
  # runner would die at its next divider, mid-sequence, the record half-written
  (trap '' PIPE; exec tee -a "$LOG" 2>/dev/null) < "$RUN_TMP/out" &
  (trap '' PIPE; exec tee -a "$LOG" >&2 2>/dev/null) < "$RUN_TMP/err" &
  exec > "$RUN_TMP/out" 2> "$RUN_TMP/err"
  BLK_DIR="$RUN_TMP/blocks"; mkdir -p "$BLK_DIR"
  NBLOCKS=$(extract_blocks "$DOC" "$BLK_DIR")
  [ "$NBLOCKS" -gt 0 ] || die 64 "no sh or bash blocks in $DOC"
  cd "$ROUTINE_HOME" || die 64 "no routines home $ROUTINE_HOME"

  divider "routine $RNAME · $STARTED_ISO"
  deadline=$(($(date +%s) + TIMEOUT))
  run_sequence & SEQ_PID=$!
  watchdog "$deadline" "$SEQ_PID" & WD_PID=$!
  wait "$SEQ_PID"; rc=$?; SEQ_PID=""
  : > "$RUN_TMP/done"
  # past the deadline the watchdog may still be escalating on the block's group
  if [ -f "$RUN_TMP/timedout" ]; then wait "$WD_PID"; rc=124; else kill "$WD_PID" 2>/dev/null; fi
  WD_PID=""
  divider "routine $RNAME · exit $rc"
  exit "$rc"
}

# A Power Nap dark wake lasts seconds: a routine dispatched into one has its
# network call frozen when the wake ends, and the wall-clock watchdog kills it on
# the next wake — cascading every routine queued behind it into 124. caffeinate
# cannot hold it open (IOPMLib.h: the idle-sleep assertion "has no effect if the
# system is in Dark Wake"), so the tick defers and derived due-ness carries over.
# ※ dark-wake-gate
dark_wake() { # true only when macOS reports a wake without Graphics — a Power Nap dark wake
  local caps
  caps=$("$ROUTINE_PMSET" -g systemstate 2>/dev/null | grep '^Current System Capabilities are:') || return 1
  [ -n "$caps" ] || return 1
  case "$caps" in *Graphics*) return 1 ;; esac
  return 0
}

due_stop() { # $1=exit code — a background child ignores INT, so every signal forwards as TERM
  trap '' HUP INT TERM
  if [ -n "${DUE_CHILD:-}" ]; then kill -TERM "$DUE_CHILD" 2>/dev/null; wait "$DUE_CHILD"; fi
  exit "$1"
}

# ※ due-tick
cmd_due() {
  local f name rc=0 drc docs=0 due="" next="" nxt ddisp="-" ndisp="-"
  # stdout is the contract's silence; the sweep narrates into tick.log instead
  rotate_due_log
  for f in "$ROUTINE_DIR"/*.md; do
    [ -e "$f" ] || continue
    name=$(basename "$f" .md)
    case "$name" in
      -*|*[!a-z0-9-]*) tick_log "skip $(basename "$f"): name not a slug"; continue ;;
    esac
    docs=$((docs + 1))
    if nxt=$(next_fire_of "$name"); then
      if [ "$nxt" -le "$(now)" ]; then due="$due $name"
      else next="$next $name@$(iso "$nxt")"
      fi
    else next="$next $name@unscheduled"
    fi
  done
  due="${due# }"; next="${next# }"
  if [ -n "$due" ]; then ddisp="${due// /,}"; fi
  if [ -n "$next" ]; then ndisp="${next// /,}"; fi
  tick_log "tick docs=$docs due=$ddisp next=$ndisp"
  # launchd stops the job with a TERM to this shell alone, then KILLs its group: the
  # routine must hear it first, so its on_exit reaps its blocks and writes the record
  trap 'due_stop 129' HUP; trap 'due_stop 130' INT; trap 'due_stop 143' TERM
  for name in $due; do
    # the host can sleep under a long routine and wake dark: probe before each one
    if dark_wake; then
      tick_log "defer dark-wake due=$ddisp"
      exit "$rc"
    fi
    ddisp="${ddisp#"$name"}"; ddisp="${ddisp#,}"
    tick_log "dispatch $name"
    "$SELF" run "$name" & DUE_CHILD=$!
    wait "$DUE_CHILD"; drc=$?; DUE_CHILD=""
    [ "$drc" -eq 0 ] || rc=1
    tick_log "dispatched $name exit=$drc"
  done
  exit "$rc"
}

cell() { # $1=text $2=width — pads by display width (bash printf pads by bytes)
  local pad="" n v="$1"
  v="${v//—/-}"
  n=$(( $2 - ${#v} ))
  while [ "$n" -gt 0 ]; do pad="$pad "; n=$((n - 1)); done
  printf '%s%s' "$1" "$pad"
}

cmd_status() {
  local f name sched due last ex fin dur deg
  printf '%s%s%s%s%s%s\n' "$(cell NAME 21)" "$(cell SCHEDULE 17)" "$(cell DUE 5)" \
    "$(cell EXIT 6)" "$(cell FINISHED 22)" SECS
  for f in "$ROUTINE_DIR"/*.md; do
    [ -e "$f" ] || continue
    name=$(basename "$f" .md)
    case "$name" in
      *[!a-z0-9-]*)
        printf 'routine: skip %s: name not a slug\n' "$(basename "$f")" >&2
        continue ;;
    esac
    sched=$(fm_get "$f" schedule)
    if [ -z "$sched" ]; then due="n/a"; sched="—"
    elif ! next_fire_after 0 "$sched" >/dev/null; then due="bad"
    elif is_due "$name"; then due="due"
    else due="—"
    fi
    last="$ROUTINE_STATE/$name/last-run.json"
    ex=$(json_get "$last" exit); fin=$(json_get "$last" finished)
    dur=$(json_get "$last" duration)
    deg=""
    if [ -f "$ROUTINE_STATE/$name/degraded" ]; then
      deg=" · degraded since $(cat "$ROUTINE_STATE/$name/degraded" 2>/dev/null)"
    fi
    printf '%s%s%s%s%s%s%s\n' "$(cell "$name" 21)" "$(cell "$sched" 17)" \
      "$(cell "$due" 5)" "$(cell "${ex:-—}" 6)" "$(cell "${fin:-—}" 22)" "${dur:-—}" "$deg"
  done
}

# ─── schedulers ───────────────────────────────────────────────────────────────

xml() { printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; } # $1=text for a plist <string>

cmd_install() {
  local plist="$ROUTINE_AGENTS_DIR/com.routines.due.plist"
  mkdir -p "$ROUTINE_AGENTS_DIR" "$ROUTINE_HOME" "$ROUTINE_STATE"
  # launchd hands a bare PATH and `bash -l` reads ~/.bash_profile, never the zsh
  # profile — so ~/.local/bin (claude, mise, sandman, stele) is absent under the
  # tick and present by hand. That asymmetry silently degrades every on_error
  # catch to `claude unavailable`; stamp the PATH the tick must run with, and the
  # anchors, or a custom ROUTINE_HOME install ticks the default ~/.routines.
  cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.routines.due</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$(xml "exec $(printf %q "$SELF") run --due")</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$(xml "$HOME")/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>ROUTINE_HOME</key><string>$(xml "$ROUTINE_HOME")</string>
    <key>ROUTINE_DIR</key><string>$(xml "$ROUTINE_DIR")</string>
    <key>ROUTINE_STATE</key><string>$(xml "$ROUTINE_STATE")</string>
  </dict>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>$(xml "$ROUTINE_STATE")/due.log</string>
  <key>StandardErrorPath</key><string>$(xml "$ROUTINE_STATE")/due.log</string>
</dict>
</plist>
EOF
  "$ROUTINE_LAUNCHCTL" bootout "gui/$(id -u)/com.routines.due" >/dev/null 2>&1
  "$ROUTINE_LAUNCHCTL" bootstrap "gui/$(id -u)" "$plist" || die 1 "launchctl bootstrap failed"
  printf 'installed %s\n' "$plist"
}

cmd_uninstall() {
  local plist="$ROUTINE_AGENTS_DIR/com.routines.due.plist"
  "$ROUTINE_LAUNCHCTL" bootout "gui/$(id -u)/com.routines.due" >/dev/null 2>&1
  rm -f "$plist"
  printf 'removed %s\n' "$plist"
}

cmd_sync_ci() {
  local wf="$PWD/.github/workflows/routines.yaml"
  mkdir -p "$PWD/.github/workflows"
  rm -f "$PWD/.github/workflows/routines.yml" # pre-.yaml name; leaving it would double-tick
  cat > "$wf" <<'EOF'
name: routines

on:
  schedule:
    - cron: '*/15 * * * *'
  workflow_dispatch:

# runners share no lock: two overlapping ticks would both fire and one save would drop the other's state
concurrency:
  group: routines
  cancel-in-progress: false

jobs:
  due:
    runs-on: ubuntu-latest
    env:
      ROUTINE_HOME: ${{ github.workspace }}/routines
    steps:
      - uses: actions/checkout@v4
      - uses: actions/cache/restore@v4
        with:
          path: routines/.state
          key: routines-state-${{ github.run_id }}
          restore-keys: routines-state-
      - run: '[ -x bin/routine ] || (mkdir -p bin && curl -fsSL https://raw.githubusercontent.com/jgeschwendt/routines/main/bin/routine -o bin/routine && chmod +x bin/routine)'
      - run: bin/routine run --due
      # actions/cache saves only on success; one red routine would roll every
      # other routine's state back and re-run it each tick
      - uses: actions/cache/save@v4
        if: always()
        with:
          path: routines/.state
          key: routines-state-${{ github.run_id }}
EOF
  printf 'wrote %s\n' "$wf"
}

# ─── dispatch ─────────────────────────────────────────────────────────────────

case "${1:-}" in
  ""|help|-h|--help) usage; exit 0 ;;
  run)
    case "${2:-}" in
      "") usage >&2; exit 64 ;;
      --due) cmd_due ;;
      *) cmd_run "$2" ;;
    esac ;;
  status) cmd_status ;;
  install) cmd_install ;;
  uninstall) cmd_uninstall ;;
  sync-ci) cmd_sync_ci ;;
  *) printf 'routine: unknown command %s\n' "$1" >&2; usage >&2; exit 64 ;;
esac
